<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
<link rel="canonical" href="https://www.beautifyearth.org{{ page.url }}">
<meta property="og:title" content="{{ title }}">
{% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
<meta property="og:url" content="https://www.beautifyearth.org{{ page.url }}">
<style>
  :root { --ink:#181a1d; --accent:#1b7fa8; --accent-dark:#14607f; --green:#2ec98c; --muted:#6b7075; --line:#e7eaec; --wash:#f6f9fa; }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin:0; font-family:'Avenir Next', Avenir, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; color:var(--ink); line-height:1.7; font-size:17px; background:#fff; }
  a { color:var(--accent); text-decoration-thickness:1px; text-underline-offset:2px; }
  a:hover { color:var(--accent-dark); }

  header { border-bottom:1px solid var(--line); background:#fff; position:sticky; top:0; z-index:10; }
  .nav { max-width:1200px; margin:0 auto; padding:14px 20px; display:flex; flex-wrap:wrap; gap:10px 22px; align-items:center; }
  .nav .brand { display:flex; align-items:center; gap:10px; text-decoration:none; }
  .nav .brand img { height:32px; width:auto; display:block; }
  .navlinks { display:flex; flex-wrap:wrap; gap:8px 30px; margin:0 auto; }
  .navlinks a { color:var(--accent); text-decoration:none; font-size:15px; font-weight:600; letter-spacing:.2px; padding:6px 0; }
  .navlinks a:hover { color:var(--accent-dark); }
  .navbtns { display:flex; gap:10px; align-items:center; }
  .navbtns a { text-decoration:none; font-size:14.5px; font-weight:600; padding:9px 18px; border-radius:8px; }
  .navbtns .login { background:var(--wash); color:var(--accent); }
  .navbtns .login:hover { background:#e8eef1; }
  .navbtns .cta { background:var(--accent); color:#fff; }
  .navbtns .cta:hover { background:var(--accent-dark); }
  @media (max-width: 760px) { .navlinks { order:3; width:100%; justify-content:center; } .navbtns { margin-left:auto; } }

  main { max-width:760px; margin:0 auto; padding:40px 20px 72px; }
  h1 { font-size:clamp(30px, 5vw, 42px); line-height:1.15; letter-spacing:-.5px; margin:0 0 18px; }
  h2 { font-size:clamp(22px, 3.5vw, 28px); line-height:1.25; margin:44px 0 12px; letter-spacing:-.3px; }
  h3, h4 { margin:32px 0 10px; line-height:1.3; }
  p { margin:0 0 18px; }
  ul, ol { padding-left:24px; margin:0 0 18px; }
  li { margin-bottom:6px; }
  main img { max-width:100%; height:auto; border-radius:10px; display:block; margin:26px auto; }
  main video { width:100%; border-radius:10px; display:block; margin:26px auto; background:#000; }
  blockquote { margin:26px 0; padding:4px 0 4px 20px; border-left:3px solid var(--green); color:#3a3f44; font-style:italic; }
  blockquote p { margin-bottom:8px; }
  hr { border:none; border-top:1px solid var(--line); margin:40px 0; }
  em { color:inherit; }
  .postmeta { color:var(--muted); font-size:14px; margin:0 0 30px; }

  .artscape { font-size:clamp(38px, 6vw, 56px); margin:10px 0 0; letter-spacing:-1px; }
  .byline { margin:2px 0 18px; font-weight:800; letter-spacing:1px; font-size:14px; color:var(--muted); }
  .byline span { font-weight:800; }
  .b1{color:#1b7fa8}.b2{color:#2ec98c}.b3{color:#e84f6b}.b4{color:#f2b134}.b5{color:#1b7fa8}.b6{color:#8a5cc9}.b7{color:#2ec98c}.b8{color:#e84f6b}
  .bloggrid { display:grid; grid-template-columns:repeat(3, 1fr); gap:26px; margin-top:40px; text-align:left; }
  .bcard { display:flex; flex-direction:column; border:1px solid var(--line); border-radius:12px; overflow:hidden; background:#fff; text-decoration:none; color:var(--ink); transition:box-shadow .15s, transform .15s; }
  .bcard:hover { box-shadow:0 6px 22px rgba(24,26,29,.10); transform:translateY(-2px); color:var(--ink); }
  .bcard img { width:100%; aspect-ratio:3/2; object-fit:cover; margin:0; border-radius:0; }
  .bcard-body { padding:16px 18px 18px; display:flex; flex-direction:column; gap:8px; }
  .bcard h2 { font-size:17.5px; line-height:1.35; margin:0; letter-spacing:0; }
  .bcard p { font-size:14px; color:#4a4f54; margin:0; line-height:1.5; }
  .bcard .d { color:var(--muted); font-size:12.5px; margin-top:auto; }
  .bcard:hover h2 { color:var(--accent); }
  @media (max-width: 900px) { .bloggrid { grid-template-columns:repeat(2, 1fr); } }
  @media (max-width: 600px) { .bloggrid { grid-template-columns:1fr; } }

  main.full { max-width:none; padding:0 0 64px; }
  .wrap { max-width:1080px; margin:0 auto; padding:0 20px; }
  .hero { position:relative; background:#1c2530 center/cover no-repeat; display:flex; align-items:center; min-height:460px; }
  .hero::before { content:""; position:absolute; inset:0; background:linear-gradient(90deg, rgba(12,20,28,.72) 0%, rgba(12,20,28,.35) 55%, rgba(12,20,28,.12) 100%); }
  .hero .wrap { position:relative; padding:88px 20px; color:#fff; }
  .hero h1 { color:#fff; margin:0 0 16px; max-width:680px; font-size:clamp(36px, 5.5vw, 58px); line-height:1.1; }
  .hero .sub { font-size:clamp(19px, 2.2vw, 25px); line-height:1.4; max-width:560px; margin:0 0 12px; }
  .hero .tagline { font-size:14.5px; opacity:.9; margin:0; }
  .btn { display:inline-block; background:var(--accent); color:#fff !important; padding:11px 26px; border-radius:999px; font-weight:600; font-size:15.5px; text-decoration:none; margin:6px 12px 6px 0; }
  .btn:hover { background:var(--accent-dark); }
  .btn.ghost { background:transparent; color:var(--accent) !important; box-shadow:inset 0 0 0 2px var(--accent); }
  .btn.ghost:hover { background:var(--accent); color:#fff !important; }
  .btn.green { background:var(--green); }
  .btn.green:hover { background:#25ad78; }
  .section { padding:56px 0 8px; }
  .split { display:grid; grid-template-columns:1fr 1.1fr; gap:48px; align-items:center; }
  .split img { margin:0; width:100%; }
  .split h2 { margin-top:0; }
  .centerhead { text-align:center; font-size:clamp(26px, 4vw, 36px); line-height:1.25; margin:24px 0 8px; letter-spacing:-.4px; }
  .cards { display:grid; grid-template-columns:repeat(3, 1fr); gap:28px; margin:40px 0 0; }
  .card { text-align:center; }
  .card img { width:100%; aspect-ratio:4/3; object-fit:cover; margin:0 0 14px; }
  .card h3 { margin:0 0 2px; font-size:18px; }
  .card p { color:var(--muted); font-size:14.5px; margin:0; line-height:1.5; }
  .schoolcols { display:grid; grid-template-columns:repeat(4, 1fr); gap:8px 24px; margin:36px 0 0; font-size:15px; }
  .schoolcols h4 { margin:0 0 10px; }
  .schoolcols ul { list-style:none; padding:0; margin:0; }
  .schoolcols li { margin-bottom:5px; color:#3a3f44; }
  .band { background:var(--wash); padding:56px 0 64px; margin-top:64px; }
  .band.dark { background:#14323f; color:#fff; margin-top:0; text-align:center; }
  .band.dark h2 { color:#fff; margin-top:0; }
  .center { text-align:center; }
  .lead { font-size:18px; max-width:760px; margin:0 auto 20px; }
  .card.boxed { border:1px solid var(--line); border-radius:14px; padding:26px 22px; background:#fff; box-shadow:0 2px 10px rgba(24,26,29,.04); }
  .card.boxed h3 { margin-top:0; }
  .card.boxed p { color:#3a3f44; font-size:15px; }
  .prose-center { max-width:720px; margin:0 auto; text-align:left; }
  .team .card img { width:180px; height:180px; aspect-ratio:1; object-fit:cover; border-radius:50%; margin:0 auto 14px; }
  .team .card .role { color:var(--muted); font-size:14px; margin:0 0 6px; }
  .team .card p { font-size:14.5px; }
  .hero.short { min-height:260px; background:linear-gradient(120deg, #14607f, #1b7fa8 55%, #2ec98c); }
  .hero.short::before { display:none; }
  .contact-tiles { gap:0; margin-top:26px; border-radius:12px; overflow:hidden; }
  .tile { display:flex; align-items:center; justify-content:center; min-height:110px; color:#fff !important; font-weight:600; text-decoration:none; font-size:16.5px; padding:16px; }
  .tile.blue { background:var(--accent); }
  .tile.pink { background:#e84f6b; }
  .tile.teal { background:var(--green); }
  .tile:hover { filter:brightness(1.08); }
  .hero.navy { background:#1c2436; min-height:300px; }
  .hero.navy::before { display:none; }
  .card img.seal, img.seal { width:120px; height:120px; aspect-ratio:1; object-fit:contain; margin:0 auto 14px; }
  .orgs { display:flex; flex-wrap:wrap; gap:22px; justify-content:center; margin-top:30px; }
  .orgs img { width:110px; height:110px; object-fit:contain; border-radius:50%; margin:0; }
  .section .split + .split { margin-top:56px; }
  img.shot { border:1px solid var(--line); }
  .cards.four { grid-template-columns:repeat(4, 1fr); }
  .cards.two { grid-template-columns:repeat(2, 1fr); }
  .eyebrow { letter-spacing:2px; font-size:13px; font-weight:600; opacity:.85; margin:0 0 8px; }
  .hero .sub.small { font-size:16px; opacity:.95; }
  .btn.pink { background:#e84f6b; }
  .btn.pink:hover { background:#cf3d58; }
  .stepsbg { background:center/cover no-repeat; padding:64px 0; }
  .stepsbg .wrap { display:flex; flex-direction:column; gap:22px; max-width:720px; }
  .stepcard { background:#fff; border-radius:12px; padding:24px 28px; text-align:center; position:relative; box-shadow:0 4px 18px rgba(0,0,0,.18); }
  .stepcard .num { display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; border-radius:50%; background:var(--accent); color:#fff; font-weight:700; position:absolute; top:-17px; left:50%; transform:translateX(-50%); }
  .stepcard h3 { margin:8px 0 8px; }
  .stepcard p { margin:0; font-size:15px; }
  .band.blue { background:var(--accent); color:#fff; }
  .band.blue h2 { color:#fff; margin-top:0; }
  .band.blue a { color:#fff; }
  img.round { border-radius:50%; width:260px; height:260px; object-fit:cover; justify-self:center; }
  details.faq { border-bottom:1px solid var(--line); padding:6px 0; }
  details.faq summary { cursor:pointer; font-weight:600; padding:14px 0; list-style:none; position:relative; padding-right:30px; }
  details.faq summary::after { content:"+"; position:absolute; right:4px; top:50%; transform:translateY(-50%); color:var(--muted); font-size:22px; font-weight:400; }
  details.faq[open] summary::after { content:"\2212"; }
  details.faq summary::-webkit-details-marker { display:none; }
  .hero.centered { text-align:center; }
  .hero.centered::before { background:rgba(12,20,28,.45); }
  .hero.centered h1, .hero.centered .sub { margin-left:auto; margin-right:auto; }
  .seal.small, .card img.seal.small { width:84px; height:84px; }
  .pillars .card h3, h3.caps { text-transform:uppercase; letter-spacing:3px; font-weight:500; font-size:16.5px; }
  .band.brush { background-size:cover; background-position:center; color:#fff; margin-top:0; }
  .band.brush h2, .band.brush h3, .band.brush p { color:#fff; }
  .howcols { display:grid; grid-template-columns:repeat(3,1fr); gap:0; margin-top:28px; text-align:left; }
  .howcols > div { padding:6px 30px; }
  .howcols > div + div { border-left:1px solid var(--line); }
  .howcols h3 { margin:0 0 6px; }
  @media (max-width: 760px) { .howcols { grid-template-columns:1fr; } .howcols > div + div { border-left:none; border-top:1px solid var(--line); } }
  .card.part { padding:0; overflow:hidden; }
  .card.part img { width:100%; aspect-ratio:4/3; object-fit:cover; margin:0 0 12px; border-radius:0; }
  .card.part h3, .card.part p { padding:0 16px; }
  .card.part p:last-child { padding-bottom:16px; }
  iframe.donorbox { max-width:500px; min-width:310px; max-height:none !important; border:none; margin:0 auto; display:block; }
  .donate-grid { display:grid; grid-template-columns:1fr 440px; gap:56px; align-items:start; }
  .donate-grid h2 { margin-top:0; }
  .donate-reasons .reason { border-left:3px solid var(--green); padding:4px 0 4px 18px; margin-bottom:22px; }
  .donate-reasons .reason h3 { margin:0 0 6px; }
  .donate-reasons .reason p { margin:0; color:#3a3f44; }
  .donate-form { position:sticky; top:86px; background:var(--wash); border:1px solid var(--line); border-radius:14px; padding:18px 12px; }
  @media (max-width: 900px) { .donate-grid { grid-template-columns:1fr; } .donate-form { position:static; order:-1; } }
  .legalnav { font-size:13.5px; color:var(--muted); border-bottom:1px solid var(--line); padding-bottom:14px; }
  .legalnav a { color:var(--muted); }
  .legalnav a:hover { color:var(--accent); }
  .card.step { text-align:left; }
  .card.step .num { display:inline-block; font-size:26px; font-weight:800; color:var(--green); margin-bottom:4px; }
  .card.step h3 { margin:0 0 6px; }
  .card.step p { margin:0 0 10px; }
  .brandgrid a.card { text-decoration:none; color:var(--ink); }
  .brandgrid a.card:hover { border-color:var(--accent); }
  .brandgrid img { width:120px; height:70px; object-fit:contain; margin:0 auto 10px; aspect-ratio:auto; }
  .brandgrid p { text-decoration:underline; text-underline-offset:3px; }
  .stats { list-style:none; padding:0; }
  .stats li { padding:10px 0 10px 16px; border-left:3px solid var(--green); margin-bottom:10px; background:var(--wash); border-radius:0 8px 8px 0; padding-right:14px; }
  .carousel { overflow:hidden; margin:8px 0 0; }
  .carousel-track { display:flex; gap:14px; width:max-content; animation:carousel-x 45s linear infinite; }
  .carousel:hover .carousel-track { animation-play-state:paused; }
  .carousel-track img { height:230px; width:auto; margin:0; border-radius:10px; }
  @keyframes carousel-x { from { transform:translateX(0); } to { transform:translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .carousel { overflow-x:auto; } .carousel-track { animation:none; } }
  .card.quote img { width:96px; height:96px; border-radius:50%; object-fit:cover; margin:0 auto 10px; }
  .logos { max-width:560px; margin:44px auto 0; }
  .award { max-width:200px; margin:10px auto 0; }
  @media (max-width: 840px) { .cards.four { grid-template-columns:repeat(2, 1fr); } .cards.two { grid-template-columns:1fr; } }
  .band .split { align-items:center; }
  .steps { padding-left:22px; }
  @media (max-width: 840px) { .split, .cards { grid-template-columns:1fr; } .schoolcols { grid-template-columns:repeat(2, 1fr); } .hero .sub { font-size:18px; } }
  footer { border-top:1px solid var(--line); background:var(--wash); margin-top:40px; }
  .foot { max-width:1080px; margin:0 auto; padding:32px 20px; font-size:14px; color:var(--muted); display:flex; flex-wrap:wrap; gap:14px 28px; justify-content:space-between; align-items:center; }
  .footnav { display:flex; flex-wrap:wrap; gap:8px 22px; width:100%; padding-bottom:14px; border-bottom:1px solid var(--line); }
  .footnav a { font-weight:500; color:var(--ink); }
  .foot a { color:var(--muted); text-decoration:none; }
  .foot a:hover { color:var(--accent); }
  .foot .social { display:flex; gap:18px; }
</style>
</head>
<body>
<header>
  <nav class="nav">
    <a class="brand" href="/" aria-label="Beautify Earth home"><img src="/images/035a3a7adf-55dc19_33494c6aff084bceb5448f7eb71ed71f_mv2.png" alt="Beautify Earth"></a>
    <div class="navlinks">
      <a href="https://art.beautifyearth.com/murals">Murals</a>
      <a href="https://art.beautifyearth.com/walls">Walls</a>
      <a href="https://art.beautifyearth.com/artists">Artists</a>
      <a href="https://art.beautifyearth.com/cities">Cities</a>
      <a href="https://www.beautifyearth.com/contact-us">Contact</a>
      <a href="/nonprofit-donate/">Donate</a>
    </div>
    <div class="navbtns">
      <a class="login" href="https://art.beautifyearth.com/signin">Log In</a>
      <a class="cta" href="https://art.beautifyearth.com/signup">Sign Up</a>
    </div>
  </nav>
</header>
<main{% if fullwidth %} class="full"{% endif %}>
{{ content | safe }}
</main>
<footer>
  <div class="foot">
    <nav class="footnav">
      <a href="/schools/">Schools</a>
      <a href="/about/">About</a>
      <a href="https://www.beautifyearth.com/contact-us">Contact</a>
      <a href="/blog/">Blog</a>
      <a href="/how-it-works/">How It Works</a>
      <a href="/cities-and-communities/">Cities &amp; Communities</a>
      <a href="/faq/">FAQ</a>
      <a href="/nonprofit-donate/">Donate</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </nav>
    <span>© Beautify Earth — producing, promoting, and advocating for art on the streets since 2012. Certified 501(c)(3).</span>
    <span class="social">
      <a href="https://www.instagram.com/beautifyearth/">Instagram</a>
      <a href="https://www.linkedin.com/company/beautifyearth/">LinkedIn</a>
      <a href="https://youtube.com/channel/UCYjz1FFe9MuyunPcL5770Kw">YouTube</a>
      <a href="https://www.beautifyearth.com">beautifyearth.com</a>
    </span>
  </div>
</footer>
</body>
</html>
